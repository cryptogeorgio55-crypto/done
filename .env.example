# ------------------------------------------------------------------
# DONE — environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Application ---------------------------------------------------
# Public base URL of the app (used for links in emails, redirects).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Secret used to sign session cookies (HMAC). Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Database ------------------------------------------------------
# Local development uses SQLite (zero setup):
DATABASE_URL="file:./dev.db"
#
# Production should use PostgreSQL. Switch prisma/schema.prisma provider
# to "postgresql" and set, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/done?schema=public"

# --- AI provider ---------------------------------------------------
# Provider is chosen automatically: the first configured one wins.
# Supported: anthropic | openai | ollama | offline (deterministic dev fallback)
# Force a provider (optional). If unset, DONE auto-detects from keys below.
AI_PROVIDER=""

# Anthropic (https://console.anthropic.com). Leave blank if you have no key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# OpenAI (optional alternative).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Ollama — free, runs locally (https://ollama.com). No API key needed.
# Install Ollama, run `ollama pull llama3.1`, then set:
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1"

# --- Admin bootstrap ----------------------------------------------
# Email that, on signup/seed, is granted platform-admin rights.
# Used by the documented bootstrap script — no hard-coded admin password.
PLATFORM_ADMIN_EMAIL=""

# --- Stripe (billing) — not required for local dev ----------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Email (transactional) — not required for local dev -----------
# Provider abstraction; when unset, emails are logged to the console.
EMAIL_PROVIDER="console"
EMAIL_FROM="DONE <no-reply@done.app>"
RESEND_API_KEY=""
