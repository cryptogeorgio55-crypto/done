# ==================================================================
# DONE — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable below is READ BY THE CODE (src/lib/config.ts).
# Legend:  [prod] required in production   [opt] optional   [feat] feature flag
# ==================================================================

# ==================================================================
# APPLICATION
# ==================================================================
NODE_ENV="development"                 # development | production
APP_URL="http://localhost:3000"        # [prod] public base URL; used for OAuth redirects & links
# PORT=3000                            # [opt] port for `next start` (defaults to 3000)

# ==================================================================
# DATABASE
# ==================================================================
# Dev: SQLite, zero setup.
DATABASE_URL="file:./dev.db"           # [prod]
# Production: PostgreSQL. Set prisma/schema.prisma datasource provider to
# "postgresql", then use e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/done?schema=public&sslmode=require"

# ==================================================================
# SECURITY  (generate each with: openssl rand -base64 32)
# ==================================================================
SESSION_SECRET=""                      # [prod] HMAC key for session cookies
ENCRYPTION_KEY=""                      # [prod] AES-256-GCM key for OAuth tokens at rest
                                       #        (dev falls back to SESSION_SECRET)

# ==================================================================
# AI PROVIDER  (first configured provider wins; else offline fallback)
# ==================================================================
AI_PROVIDER=""                         # [opt] force: anthropic | openai | ollama | offline
ANTHROPIC_API_KEY=""                   # [prod] recommended provider (console.anthropic.com)
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_API_KEY=""                      # [opt] alternative provider
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_BASE_URL=""                     # [opt] local, free (ollama.com); no key needed
OLLAMA_MODEL="llama3.1"

# ==================================================================
# GOOGLE OAUTH  (Gmail + Calendar) — see SETUP-GOOGLE.md
# ==================================================================
# YOU configure this once as the platform. Customers just click "Connect".
# Authorized redirect URI (exact):  {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""                    # [prod] Google Cloud → Credentials → OAuth client
GOOGLE_CLIENT_SECRET=""                # [prod]
GOOGLE_REDIRECT_BASE=""                # [opt] defaults to APP_URL

# ==================================================================
# ADMIN
# ==================================================================
PLATFORM_ADMIN_EMAIL=""                # [opt] convenience for `npm run admin:create`

# ------------------------------------------------------------------
# NOT part of this build (documented so nothing is silently assumed):
#   • Stripe payments  — plans & entitlements are enforced in-app, but no
#                        payment provider is wired. See PRODUCTION_SETUP.md.
#   • Transactional email — customer email flows run through the connected
#                        Gmail account, not a separate email provider.
#   • Redis / queues / storage / Sentry — not used; the DONE Loop runs
#                        on-demand via API routes (and optional cron).
# ------------------------------------------------------------------
