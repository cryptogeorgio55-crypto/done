// DONE — Prisma schema
// Local dev uses SQLite for zero-setup. For production, change `provider` to
// "postgresql" and update DATABASE_URL. Fields use String for enum-like values
// and Json for structured data to stay portable across both engines.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  avatarUrl       String?
  passwordHash    String
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  memberships        Membership[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  ownedWorkspaces    Workspace[]         @relation("WorkspaceOwner")

  @@index([email])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha-256 of the raw session token (never store raw)
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  purpose    String // "email_verify" | "password_reset"
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  ownerId     String
  timezone    String    @default("UTC")
  currency    String    @default("USD")
  locale      String    @default("en")
  industryKey String? // references an industry preset key
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships     Membership[]
  businessProfile BusinessProfile?
  products        ProductService[]
  personas        CustomerPersona[]
  brandProfile    BrandProfile?
  goals           BusinessGoal[]
  policies        BusinessPolicy[]
  aiGenerations   AiGeneration[]
  lazyRuns        LazyRun[]
  campaigns       Campaign[]
  contentItems    ContentItem[]
  leads           Lead[]
  conversations   Conversation[]
  usageRecords    UsageRecord[]
  subscription    Subscription?
  notifications   Notification[]
  auditLogs       AuditLog[]

  // Autonomous OS
  integrationAccounts IntegrationAccount[]
  events              Event[]
  automationRules     AutomationRule[]
  automationRuns      AutomationRun[]
  approvals           Approval[]
  actionLogs          ActionLog[]
  autonomySettings    AutonomySettings?
  operatingRules      OperatingRule[]
  memories            Memory[]
  externalEntities    ExternalEntity[]
  entityLinks         EntityLink[]
  knowledgeSources    KnowledgeSource[]
  knowledgeDocuments  KnowledgeDocument[]

  // Autonomous AI Business OS — agentic layer
  missions     Mission[]
  missionSteps MissionStep[]
  commitments  Commitment[]
  agentRuns    AgentRun[]

  @@index([ownerId])
  @@index([slug])
}

model Membership {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("owner") // owner | admin | member
  invitedById String?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Business Brain
// ---------------------------------------------------------------------------

model BusinessProfile {
  id           String   @id @default(uuid())
  workspaceId  String   @unique
  businessName String
  industryKey  String?
  description  String?
  location     String?
  website      String?
  instagram    String?
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ProductService {
  id             String    @id @default(uuid())
  workspaceId    String
  name           String
  description    String?
  price          String? // stored as text to support ranges/currency ("$25", "from $40")
  category       String?
  benefits       String?
  targetCustomer String?
  availability   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CustomerPersona {
  id          String   @id @default(uuid())
  workspaceId String
  label       String
  ageGroups   String?
  interests   String?
  locations   String?
  painPoints  String?
  motivations String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BrandProfile {
  id           String   @id @default(uuid())
  workspaceId  String   @unique
  toneOfVoice  String?
  personality  String?
  vocabulary   String?
  wordsToAvoid String?
  colors       String?
  usps         String? // unique selling propositions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BusinessGoal {
  id          String   @id @default(uuid())
  workspaceId String
  key         String // bookings | sales | awareness | repeat | leads | engagement
  label       String
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BusinessPolicy {
  id          String   @id @default(uuid())
  workspaceId String
  kind        String // delivery | cancellation | refund | booking | payment | hours
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// AI system
// ---------------------------------------------------------------------------

model AiGeneration {
  id            String   @id @default(uuid())
  workspaceId   String
  userId        String?
  kind          String // content | campaign | reply | followup | plan | offer | ad | lazy
  provider      String
  model         String
  status        String   @default("succeeded") // succeeded | failed
  inputSummary  String?
  contextRefs   Json? // ids of business-brain/history items used to build context
  output        Json // structured, validated output
  edited        Boolean  @default(false)
  campaignId    String?
  contentItemId String?
  lazyRunId     String?
  tokensIn      Int?
  tokensOut     Int?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([workspaceId, createdAt])
}

model LazyRun {
  id             String    @id @default(uuid())
  workspaceId    String
  userId         String?
  idempotencyKey String? // prevents duplicate runs
  status         String    @default("completed") // planning | generating | completed | failed
  plan           Json? // safe decision summary (no raw chain-of-thought)
  resultKind     String? // what DONE decided to create
  campaignId     String?
  message        String? // the friendly "I noticed..." line
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Campaigns & content
// ---------------------------------------------------------------------------

model Campaign {
  id          String    @id @default(uuid())
  workspaceId String
  title       String
  objective   String?
  audience    String?
  offer       String?
  status      String    @default("draft") // draft | active | archived
  source      String    @default("manual") // manual | lazy | get_customers
  summary     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    CampaignAsset[]

  @@index([workspaceId, status])
}

model CampaignAsset {
  id         String   @id @default(uuid())
  campaignId String
  kind       String // instagram_post | caption | story | reel | whatsapp | followup | cta | ad | checklist
  title      String?
  body       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model ContentItem {
  id           String    @id @default(uuid())
  workspaceId  String
  type         String // instagram_post | caption | reel_idea | reel_script | story | ...
  title        String?
  body         String
  status       String    @default("draft") // draft | approved | scheduled | published | archived
  scheduledFor DateTime?
  campaignId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledFor])
}

// ---------------------------------------------------------------------------
// Leads, follow-ups, conversations
// ---------------------------------------------------------------------------

model Lead {
  id             String    @id @default(uuid())
  workspaceId    String
  name           String
  email          String?
  phone          String?
  source         String?
  stage          String    @default("new") // new | contacted | interested | followup | won | lost
  notes          String?
  estimatedValue String?
  tags           Json?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadNotes LeadNote[]

  @@index([workspaceId, stage])
  @@index([workspaceId, nextFollowUpAt])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Conversation {
  id          String   @id @default(uuid())
  workspaceId String
  title       String?
  channel     String? // whatsapp | instagram | email | other
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String // customer | business
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Billing, plans, usage, entitlements
// ---------------------------------------------------------------------------

model Plan {
  id                   String   @id @default(uuid())
  key                  String   @unique // free | starter | pro
  name                 String
  priceMonthly         Int      @default(0) // in minor units (cents)
  priceYearly          Int      @default(0)
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  entitlements         Json // { aiGenerationsPerMonth, leads, teamMembers, ... }
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(uuid())
  workspaceId          String    @unique
  planId               String
  status               String    @default("trialing") // trialing | active | past_due | canceled | incomplete
  billingInterval      String    @default("monthly")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([planId])
}

model UsageRecord {
  id          String   @id @default(uuid())
  workspaceId String
  metric      String // ai_generation | lazy_run | campaign | content
  period      String // YYYY-MM bucket for monthly limits
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, period])
  @@index([workspaceId, period])
}

// ---------------------------------------------------------------------------
// Platform: notifications, audit, flags, settings
// ---------------------------------------------------------------------------

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  kind        String
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, readAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([action])
}

model FeatureFlag {
  id           String   @id @default(uuid())
  key          String   @unique
  description  String?
  enabled      Boolean  @default(false)
  workspaceIds Json? // optional allowlist of workspace ids
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// AUTONOMOUS AI BUSINESS OS
// ===========================================================================
//
// Design notes:
// - Provider tokens are NEVER stored in plaintext. OAuthToken holds AES-256-GCM
//   ciphertext only. The frontend never receives them.
// - Every autonomous artifact (account, event, run, approval, action, memory,
//   entity) is workspace-scoped. Tenant isolation is enforced in application
//   code via requireWorkspaceContext — these FKs make leakage structurally hard.
// - Enum-like fields use String for SQLite portability, matching the rest of
//   the schema.

// ---------------------------------------------------------------------------
// Integrations / connectors
// ---------------------------------------------------------------------------

/**
 * A workspace's connection to one external provider (gmail, calendar, ...).
 */
model IntegrationAccount {
  id                String    @id @default(uuid())
  workspaceId       String
  provider          String // gmail | google_calendar | google_drive | slack | ...
  status            String    @default("disconnected") // connected | disconnected | needs_attention | error
  mode              String    @default("sandbox") // oauth | sandbox (simulated, honestly labelled)
  displayName       String? // e.g. the connected email address
  externalAccountId String?
  scopes            Json? // string[] of granted provider scopes
  config            Json? // provider-specific, non-secret settings
  health            String    @default("unknown") // ok | degraded | down | unknown
  healthDetail      String?
  lastSyncedAt      DateTime?
  lastErrorAt       DateTime?
  connectedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token      OAuthToken?
  syncStates SyncState[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
}

/**
 * Encrypted OAuth credentials for an integration account. Ciphertext only.
 */
model OAuthToken {
  id              String    @id @default(uuid())
  accountId       String    @unique
  accessTokenEnc  String // AES-256-GCM ciphertext (iv:tag:data), never plaintext
  refreshTokenEnc String?
  tokenType       String?   @default("Bearer")
  scope           String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/**
 * Incremental sync cursors/checkpoints per account + resource.
 */
model SyncState {
  id         String    @id @default(uuid())
  accountId  String
  resource   String // messages | events | files
  cursor     String? // provider history id / page token / delta link
  checkpoint Json?
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, resource])
}

// ---------------------------------------------------------------------------
// Event system
// ---------------------------------------------------------------------------

/**
 * A normalized business event flowing through the DONE Loop.
 */
model Event {
  id          String    @id @default(uuid())
  workspaceId String
  type        String // email.received | lead.followup_due | calendar.event_starting | ...
  source      String // gmail | google_calendar | internal | ...
  category    String? // needs_attention | sales | customers | operations | finance | meetings | marketing | done_auto
  status      String    @default("new") // new | processing | processed | ignored | failed
  dedupeKey   String // provider event id or synthesized; unique per workspace
  title       String?
  summary     String?
  payload     Json // normalized, untrusted external content lives here
  entityId    String? // linked ExternalEntity/person if known
  urgency     String? // low | normal | high
  confidence  Float?
  occurredAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
  runId       String? // AutomationRun that processed it
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Automations & runs (a "DONE Run" is an AutomationRun)
// ---------------------------------------------------------------------------

model AutomationRule {
  id           String    @id @default(uuid())
  workspaceId  String
  key          String? // stable key for built-in rules (reply_new_leads, ...)
  name         String
  description  String?
  trigger      String // event type or "schedule:morning_briefing"
  conditions   Json? // structured condition spec
  actions      Json? // ordered action templates
  spec         Json? // parsed natural-language spec (for NL automations)
  enabled      Boolean   @default(true)
  builtin      Boolean   @default(false)
  lastRunAt    DateTime?
  lastStatus   String?
  runCount     Int       @default(0)
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([workspaceId, enabled])
}

model AutomationRun {
  id             String    @id @default(uuid())
  workspaceId    String
  ruleId         String?
  trigger        String // event | lazy | schedule | manual
  eventId        String?
  status         String    @default("running") // running | completed | needs_approval | failed
  intent         String?
  summary        String? // safe decision summary — never raw chain-of-thought
  message        String? // friendly owner-facing line
  actionsPlanned Int       @default(0)
  actionsDone    Int       @default(0)
  approvalsCount Int       @default(0)
  offline        Boolean   @default(false)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  steps     AutomationStep[]
  approvals Approval[]
  actions   ActionLog[]

  @@index([workspaceId, startedAt])
  @@index([workspaceId, status])
}

model AutomationStep {
  id        String   @id @default(uuid())
  runId     String
  seq       Int      @default(0)
  tool      String
  risk      String   @default("low") // low | medium | high
  status    String   @default("pending") // pending | done | approval | blocked | failed | skipped
  input     Json?
  output    Json?
  decision  String? // auto | approval | never | ignore
  reason    String?
  error     String?
  createdAt DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Approvals
// ---------------------------------------------------------------------------

model Approval {
  id          String    @id @default(uuid())
  workspaceId String
  runId       String?
  title       String
  description String?
  actionType  String // send_email | create_event | update_lead | send_followup | ...
  risk        String    @default("medium")
  source      String? // gmail | internal | ...
  previewText String? // human-readable preview of the exact action
  reason      String? // why DONE proposes this
  payload     Json // the exact validated action input to execute on approval
  status      String    @default("pending") // pending | approved | rejected | expired | executed | failed
  decidedById String?
  decidedAt   DateTime?
  executedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

// ---------------------------------------------------------------------------
// Action log — the "DONE Activity" feed
// ---------------------------------------------------------------------------

model ActionLog {
  id          String    @id @default(uuid())
  workspaceId String
  runId       String?
  tool        String
  capability  String? // e.g. gmail.send_message
  risk        String    @default("low")
  status      String    @default("success") // success | failed | blocked | pending_approval
  decision    String? // auto | approval | never
  title       String
  detail      String?
  reason      String? // "Why did DONE do this?" concise summary
  reversible  Boolean   @default(false)
  undoToken   String?
  undoneAt    DateTime?
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Autonomy configuration & operating manual
// ---------------------------------------------------------------------------

model AutonomySettings {
  id               String   @id @default(uuid())
  workspaceId      String   @unique
  level            String   @default("prepare") // assist | prepare | autopilot | custom
  paused           Boolean  @default(false) // kill switch
  pausedReason     String?
  categoryPolicies Json? // { sales_reply: "auto"|"approval"|"never", complaint: ..., ... }
  businessHours    Json? // { timezone, days: [1..5], start: "09:00", end: "18:00" }
  dailyActionLimit Int      @default(50)
  monthlyAiBudget  Int? // soft cap on autonomous AI calls per month
  senderName       String?
  signature        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Explicit operating rules ("Never discount without asking me.").
 */
model OperatingRule {
  id          String   @id @default(uuid())
  workspaceId String
  category    String // communication | sales | scheduling | discount | support | approval | escalation
  rule        String
  source      String   @default("manual") // manual | inferred
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category])
}

// ---------------------------------------------------------------------------
// Memory system (profile | operational | relationship | knowledge | execution)
// ---------------------------------------------------------------------------

model Memory {
  id          String    @id @default(uuid())
  workspaceId String
  layer       String // profile | operational | relationship | knowledge | execution
  subjectType String? // lead | customer | person | ...
  subjectId   String?
  key         String? // optional dedupe key within a subject+layer
  content     String
  importance  Int       @default(0)
  metadata    Json?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, layer])
  @@index([workspaceId, subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Entity graph
// ---------------------------------------------------------------------------

/**
 * A person/company/thread/etc. discovered in a connected system.
 */
model ExternalEntity {
  id          String   @id @default(uuid())
  workspaceId String
  provider    String // gmail | google_calendar | internal | ...
  kind        String // person | company | thread | message | event | file | order
  externalId  String
  displayName String?
  email       String?
  data        Json?
  leadId      String? // link to internal Lead when resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, kind, externalId])
  @@index([workspaceId, kind])
  @@index([workspaceId, email])
}

model EntityLink {
  id          String   @id @default(uuid())
  workspaceId String
  fromType    String
  fromId      String
  toType      String
  toId        String
  relation    String // belongs_to | mentions | scheduled_with | proposal_for | ...
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, fromType, fromId])
  @@index([workspaceId, toType, toId])
}

// ---------------------------------------------------------------------------
// Connected knowledge (documents from Drive etc.)
// ---------------------------------------------------------------------------

model KnowledgeSource {
  id            String    @id @default(uuid())
  workspaceId   String
  provider      String // google_drive | manual | website
  label         String
  externalId    String? // folder id
  status        String    @default("active") // active | paused | error
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@index([workspaceId])
}

model KnowledgeDocument {
  id          String   @id @default(uuid())
  workspaceId String
  sourceId    String?
  title       String
  kind        String? // price_list | policy | faq | proposal | menu | contract | doc
  externalId  String?
  content     String // extracted text (indexed by naive keyword search for now)
  version     String?
  freshness   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Agentic layer — Missions, Goals, Commitments, Agent runs
//
// A Mission is a durable, multi-step objective the AI pursues over time. Its
// steps persist across restarts and deployments, so autonomous work survives
// a browser close or a server redeploy. Missions are the unit of real agentic
// work; a NextMove can spawn one via the mission engine.
// ---------------------------------------------------------------------------

model Mission {
  id           String    @id @default(uuid())
  workspaceId  String
  kind         String // sales_close | lead_reactivation | meeting_prep | goal | custom
  title        String
  objective    String // one-line human objective ("Close Sarah today")
  status       String    @default("active") // active | waiting_approval | blocked | completed | cancelled
  autonomy     String    @default("prepare") // observe | suggest | prepare | auto — per-mission autonomy
  priority     Int       @default(0)
  goalKey      String? // links a Mission to a BusinessGoal.key when goal-directed
  origin       String    @default("next_move") // next_move | goal | chief_of_staff | manual
  subjectType  String? // lead | customer | event | ...
  subjectId    String?
  context      Json? // grounded snapshot the mission was created from (not model chain-of-thought)
  result       Json? // structured outcome once complete
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     MissionStep[]

  @@index([workspaceId, status])
  @@index([workspaceId, goalKey])
}

model MissionStep {
  id               String    @id @default(uuid())
  workspaceId      String
  missionId        String
  seq              Int
  title            String
  kind             String // observe | analyze | prepare | approve | execute | verify | followup
  status           String    @default("pending") // pending | running | waiting_approval | done | failed | skipped
  tool             String? // tool this step executes when authorized
  requiresApproval Boolean   @default(false)
  detail           String?
  approvalId       String? // links to Approval when the step is gated
  actionLogId      String? // links to ActionLog once executed
  result           Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mission   Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, missionId])
  @@index([missionId, seq])
}

/**
 * A promise detected in communication — by the owner or by a customer.
 */
model Commitment {
  id          String    @id @default(uuid())
  workspaceId String
  direction   String // ours | theirs — who made the promise
  party       String // person/company the promise involves
  subjectType String? // lead | customer | person
  subjectId   String?
  text        String // "Send Sarah the proposal"
  dueAt       DateTime?
  status      String    @default("open") // open | fulfilled | overdue | dismissed
  source      String    @default("detected") // detected | manual
  sourceRef   String? // message/thread id it was detected from
  confidence  Float     @default(0.6)
  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, direction, status])
}

/**
 * Observability record for a single agent execution (Mission Control + admin AI).
 */
model AgentRun {
  id          String   @id @default(uuid())
  workspaceId String
  agent       String // executive | sales | customer | calendar | marketing | operations | research
  trigger     String // coordinator | mission | schedule | manual
  status      String   @default("completed") // running | completed | failed
  proposals   Int      @default(0)
  tokensIn    Int?
  tokensOut   Int?
  usedAi      Boolean  @default(false)
  model       String?
  ms          Int? // wall-clock duration
  summary     String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, agent])
  @@index([workspaceId, createdAt])
}
